<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Sandbox local file access for reading app containers -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>

    <!-- Container access for reading TrollStore app data directories -->
    <key>com.apple.private.security.container-required</key>
    <false/>

    <!-- Allow reading files outside app sandbox (local research only) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Process debugging capabilities for local Frida attachment -->
    <key>com.apple.system-task-ports</key>
    <true/>

    <key>get-task-allow</key>
    <true/>

    <!-- JIT support for Frida gadget runtime -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>

    <key>com.apple.developer.kernel.extended-virtual-addressing</key>
    <true/>

    <!-- Dynamic code signing for Frida gadget injection -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>

    <!-- Network capability for LLM API requests -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>

    <!-- Inter-process communication for Frida gadget -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Platform application for TrollStore compatibility -->
    <key>platform-application</key>
    <true/>

    <!-- Private entitlements for process listing and attachment -->
    <key>com.apple.private.tcc.allow</key>
    <array>
        <string>kTCCServiceSystemPolicyAllFiles</string>
    </array>
</dict>
</plist>
